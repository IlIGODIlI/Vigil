# Vigil Backend Environment Variables

APP_NAME="VIGIL Backend"
APP_VERSION="1.0.0"
DEBUG=False

# Database URL (SQL Server / Azure SQL or SQLite)
DATABASE_URL="sqlite:///./vigil.db"

# GitHub App Integration Configuration
GITHUB_APP_ID="123456"
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_PRIVATE_KEY_PATH=""
GITHUB_WEBHOOK_SECRET="your_webhook_secret_here"
GITHUB_API_BASE_URL="https://api.github.com"

# CORS Configuration
CORS_ORIGINS=["*"]

# AI Model Configuration (active pipeline — OpenAICompatibleProvider → AIModelGateway)
# Provider: Google Gemini via OpenAI-compatible endpoint
# Obtain your API key from: https://aistudio.google.com/apikey
AI_API_KEY="your_google_ai_studio_api_key_here"
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_MODEL="gemini-3.8-flash"
AI_TIMEOUT_SECONDS=60.0
AI_MAX_RETRIES=3
